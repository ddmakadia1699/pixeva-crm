# ==========================================
# PIXEVA CRM ENVIRONMENT VARIABLES
# ==========================================

# 1. SUPABASE (public values; safe in the browser and in Vercel)
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 2. AWS API (public URL of the deployed API Gateway; not a secret)
# The frontend needs NO AWS credentials. Never put AWS access keys in Vercel or in the browser.
NEXT_PUBLIC_AWS_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# 3. LOCAL LAMBDA DEVELOPMENT ONLY (lambda/local_dev.py)
# The Supabase secret key lives in the Lambda stack (SAM parameter), never in Vercel.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# 4. VERCEL / APP URL CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
